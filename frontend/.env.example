# Environment Variables Example
# Copy this file to .env.local for local development

# FastAPI Backend URL
#
# Sviluppo locale (frontend su :3000, backend su :8000, origini diverse):
#   NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
#
# Produzione (Jenkins + Docker + nginx): la variabile resta VUOTA. Frontend e
# backend stanno dietro lo stesso nginx, quindi lib/api.ts usa l'URL relativo
# /api/v1 e non esiste un host da mantenere qui; Dockerfile.frontend costruisce
# l'immagine con ENV NEXT_PUBLIC_API_URL="" a prescindere da questo file.
# Vedi docs/deployment/DEPLOY-JENKINS-DOCKER.md
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
