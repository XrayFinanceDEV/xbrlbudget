+_TITOLO_SP_RE = re.compile(r"^(?:STATO|SITUAZIONE)\s+PATRIMONIALE\b")
+_TITOLO_CE_RE = re.compile(r"^CONTO\s+ECONOMICO\b")
+
+
+def _be_ce_title_cut(words) -> Optional[float]:
+    """Ordinata (y) della riga-titolo "CONTO ECONOMICO" quando la stessa pagina porta,
+    PIU' IN ALTO, una riga-titolo "STATO/SITUAZIONE PATRIMONIALE": e' il punto in cui
+    la pagina passa dallo SP al CE. Il titolo deve aprire la sua riga (non una
+    didascalia tipo "Utile da conto economico"), e sotto deve esserci almeno un
+    importo; altrimenti None (pagina di una sola sezione)."""
+    from collections import defaultdict
+    lines = defaultdict(list)
+    for w in words:
+        lines[(w[5], w[6])].append(w)
+    sp_y = ce_y = None
+    for ws in lines.values():
+        ws.sort(key=lambda w: w[7])
+        txt = ' '.join(w[4] for w in ws).strip().upper()
+        y = min(w[1] for w in ws)
+        if _TITOLO_SP_RE.match(txt) and (sp_y is None or y < sp_y):
+            sp_y = y
+        elif _TITOLO_CE_RE.match(txt) and (ce_y is None or y < ce_y):
+            ce_y = y
+    if sp_y is None or ce_y is None or ce_y <= sp_y:
+        return None
+    cut = ce_y - 0.5
+    if not any((w[1] + w[3]) / 2 >= cut and _C8_AMOUNT_RE.match(w[4]) for w in words):
+        return None
+    return cut
+
