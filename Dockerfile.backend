FROM python:3.12-slim

WORKDIR /app

# System deps for lxml, reportlab, matplotlib; curl for healthcheck; xz-utils to
# unpack the pinned Typst release asset (tools/typst/install.sh below); ca-certificates
# for the HTTPS fetch of that asset; bubblewrap for the Typst renderer's mandatory
# sandbox (backend/app/renderers/typst/runtime.py — no unsandboxed fallback exists).
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libxml2-dev libxslt1-dev libffi-dev curl ca-certificates xz-utils bubblewrap \
    && rm -rf /var/lib/apt/lists/*

# Python deps (cached layer)
COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

# Typst compiler: fetched from GitHub and verified against tools/typst/manifest.json
# HERE, at BUILD TIME, never at container startup (entrypoint.sh does no network
# calls). install.sh checks the SHA-256 of the downloaded archive against the pinned
# manifest digest BEFORE extracting anything, and refuses (exit 3) on a mismatch —
# see tools/typst/install.sh and tools/typst/verify.sh. This layer is cached
# independently of application code, so ordinary app changes never re-trigger the
# download; only a manifest.json version/checksum bump does.
# The font bundle Typst compiles against (backend/app/renderers/typst/templates/
# dossier-base/fonts/*.ttf) is already committed in the repo and arrives with the
# COPY backend/ backend/ step below — nothing to fetch for it here.
COPY tools/typst/manifest.json tools/typst/install.sh tools/typst/verify.sh \
     tools/typst/healthcheck.py tools/typst/healthcheck-fixture.json tools/typst/
RUN bash tools/typst/install.sh && bash tools/typst/verify.sh

# Copy shared modules + backend (preserves project root structure)
COPY config.py config.py
COPY database/ database/
COPY calculations/ calculations/
COPY importers/ importers/
COPY pdf_service/ pdf_service/
COPY contracts/ contracts/
COPY backend/ backend/
COPY migrate_db.py migrate_db.py
COPY tools/migrate_report_editorial.py tools/migrate_report_editorial.py

# Stage data files (taxonomy, rating tables) outside volume mount path
# The entrypoint will sync these to /app/data on every startup
COPY data/ /app/data-staging/

# Data directory for SQLite volume mount
RUN mkdir -p /app/data

# Entrypoint script
COPY backend/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
