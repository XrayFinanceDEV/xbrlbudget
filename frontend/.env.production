# lib/api.ts cade sul ramo relativo /api/v1 e non c'è alcun host da tenere aggiornato.
# Lo impone comunque l'immagine reale: Dockerfile.frontend costruisce con
# ENV NEXT_PUBLIC_API_URL="". Vedi docs/deployment/DEPLOY-JENKINS-DOCKER.md
NEXT_PUBLIC_API_URL=
